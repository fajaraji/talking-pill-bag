# Talking Pill Bag — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. API keys must never enter code or Git.

# OpenAI-compatible LLM endpoint (Tencent Hunyuan, Gemini, OpenAI, etc.)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-api-key-here

# Vision model for reading medication labels and blood pressure screens
LLM_VISION_MODEL=gpt-4o

# Text model for simplifying/translating medication explanations
LLM_TEXT_MODEL=gpt-4o-mini
